# 复制成 commit-msg.env 后填写（install.sh 会自动帮你复制）。
# 该文件已被 .gitignore 忽略，不会进版本库。
# 值可以带引号、行尾可以写注释，脚本都能处理。

# 总开关。改成 false 就停用自动生成（提交照常，只是不再帮你写消息）。
ENABLED=true

# ── 接口 1（主用）────────────────────────────────
# 地址填到 /v1 为止，脚本自动拼 /chat/completions
API_BASE=https://api.openai.com/v1
API_KEY=
API_MODEL=gpt-4o-mini

# ── 接口 2（备用）────────────────────────────────
# 主用挂了（超时、401、限流、服务端报错）就自动换到这个，以此类推。
# 编号连不连续都行，按数字从小到大试；没填 API_KEY 的会被跳过。
# API_MODEL_2 不填就沿用上面的 API_MODEL。
# API_BASE_2=https://api.example.com/v1
# API_KEY_2=
# API_MODEL_2=

# ── 接口 3 ──────────────────────────────────────
# API_BASE_3=
# API_KEY_3=
# API_MODEL_3=
