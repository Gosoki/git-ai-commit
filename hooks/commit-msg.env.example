# 复制成 commit-msg.env 后填写（install.sh 会自动帮你复制）。
# 该文件已被 .gitignore 忽略，不会进版本库。
# 值可以带引号、行尾可以写 # 注释，都能正确解析。

[global]
# 总开关，false 就停用自动生成（提交照常，只是不再帮你写消息）
enabled = true
# 各接口没单独写 model 时用这个
model = gpt-4o-mini


# 下面每个 [段落] 就是一个接口，段落名随便起（只用来在日志里标识）。
# 按从上到下的顺序试，前一个挂了（超时、401、限流、服务端报错、返回空）就自动换下一个。
# base 填到 /v1 为止，脚本自动拼 /chat/completions。
# 没填 key 的段落会被跳过，所以备用接口可以先留着空占位。

[openai]
base = https://api.openai.com/v1
key =
model = gpt-4o-mini

[备用]
base =
key =
model =
